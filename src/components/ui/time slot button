export function TimeSlot({
  time,
  selected,
}: {
  time: string
  selected?: boolean
}) {
  return (
    <button
      className={cn(
        "px-4 py-2 rounded-xl type-time-value transition-apple",
        selected
          ? "bg-primary text-primary-fg shadow-glow"
          : "bg-muted text-fg hover:bg-secondary"
      )}
    >
      {time}
    </button>
  )
}
