{
  "name": "Therapist",
  "type": "object",
  "properties": {
    "name_th": {
      "type": "string",
      "description": "Name in Thai"
    },
    "name_en": {
      "type": "string",
      "description": "Name in English"
    },
    "nickname": {
      "type": "string",
      "description": "Nickname"
    },
    "photo_url": {
      "type": "string"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of service category specialties"
    },
    "bio_th": {
      "type": "string"
    },
    "bio_en": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5.0
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "work_days": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Days available e.g. ['mon','tue','wed']"
    },
    "work_start": {
      "type": "string",
      "description": "Start time e.g. 09:00"
    },
    "work_end": {
      "type": "string",
      "description": "End time e.g. 20:00"
    }
  },
  "required": [
    "name_th",
    "name_en",
    "nickname"
  ]
}