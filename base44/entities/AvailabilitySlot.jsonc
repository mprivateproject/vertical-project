{
  "name": "AvailabilitySlot",
  "type": "object",
  "properties": {
    "slot_date": {
      "type": "string",
      "format": "date",
      "description": "The date of this slot (yyyy-MM-dd)"
    },
    "start_time": {
      "type": "string",
      "description": "Start time e.g. 10:00"
    },
    "max_concurrent": {
      "type": "number",
      "default": 1,
      "description": "Max simultaneous bookings allowed at this slot"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this slot is open for booking"
    }
  },
  "required": [
    "slot_date",
    "start_time"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}