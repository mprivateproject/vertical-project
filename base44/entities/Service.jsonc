{
  "name": "Service",
  "type": "object",
  "properties": {
    "name_th": {
      "type": "string",
      "description": "Service name in Thai"
    },
    "name_en": {
      "type": "string",
      "description": "Service name in English"
    },
    "description_th": {
      "type": "string",
      "description": "Description in Thai"
    },
    "description_en": {
      "type": "string",
      "description": "Description in English"
    },
    "category": {
      "type": "string",
      "enum": [
        "massage",
        "facial",
        "body_treatment",
        "package",
        "wellness"
      ],
      "description": "Service category"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Duration in minutes"
    },
    "price": {
      "type": "number",
      "description": "Price in THB"
    },
    "original_price": {
      "type": "number",
      "description": "Original price before discount"
    },
    "image_url": {
      "type": "string",
      "description": "Service image URL"
    },
    "is_popular": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name_th",
    "name_en",
    "category",
    "duration_minutes",
    "price"
  ]
}