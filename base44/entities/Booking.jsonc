{
  "name": "Booking",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User.id"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer record ID"
    },
    "customer_name": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "therapist_id": {
      "type": "string"
    },
    "therapist_name": {
      "type": "string"
    },
    "booking_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "description": "e.g. 14:00"
    },
    "end_time": {
      "type": "string",
      "description": "e.g. 15:30"
    },
    "duration_minutes": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "checked_in",
        "in_progress",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "pending"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "pending",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "promptpay",
        "bank_transfer",
        "truemoney",
        "rabbit_line_pay",
        "credit_card",
        "cash"
      ],
      "description": "Payment method used"
    },
    "staff_notes": {
      "type": "string"
    },
    "customer_notes": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Optional booking description or special requests",
      "maxLength": 1000
    },
    "rating": {
      "type": "number"
    },
    "review_text": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "customer_id",
    "service_id",
    "booking_date",
    "start_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}