{
  "name": "User",
  "type": "object",
  "properties": {
    "line_user_id": {
      "type": "string",
      "description": "LINE User ID for authentication"
    },
    "name": {
      "type": "string",
      "description": "User display name"
    },
    "picture_url": {
      "type": "string",
      "description": "User profile picture URL"
    },
    "role": {
      "type": "string",
      "enum": [
        "customer",
        "staff",
        "admin"
      ],
      "default": "customer",
      "description": "User role in the application"
    }
  },
  "required": [
    "line_user_id",
    "role"
  ]
}