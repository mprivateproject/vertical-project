{
  "name": "Customer",
  "type": "object",
  "properties": {
    "line_user_id": {
      "type": "string",
      "description": "LINE userId (sub) \u2014 primary identity key"
    },
    "user_id": {
      "type": "string",
      "description": "Reference to User.id (optional)"
    },
    "display_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "picture_url": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "Staff notes about this customer"
    },
    "preferred_language": {
      "type": "string",
      "enum": ["th", "en"],
      "default": "th"
    },
    "total_visits": {
      "type": "number",
      "default": 0
    },
    "loyalty_points": {
      "type": "number",
      "default": 0
    },
    "tier": {
      "type": "string",
      "enum": ["bronze", "silver", "gold", "platinum"],
      "default": "bronze"
    },
    "is_invited": {
      "type": "boolean",
      "default": false
    },
    "invitation_code": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "data.line_user_id": "{{user.line_user_id}}" }
      ]
    },
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "staff" } },
        { "data.line_user_id": "{{user.line_user_id}}" }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "data.line_user_id": "{{user.line_user_id}}" }
      ]
    },
    "delete": {
      "user_condition": { "role": "admin" }
    },
    "write": {
      "user_condition": { "role": "admin" }
    }
  }
}
