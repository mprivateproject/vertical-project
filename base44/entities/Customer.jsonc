{
  "name": "Customer",
  "type": "object",
  "properties": {
    "line_user_id": {
      "type": "string",
      "description": "LINE userId (sub) \u2014 primary identity key"
    },
    "user_id": {
      "type": "string",
      "description": "Reference to User.id (optional)"
    },
    "display_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "picture_url": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "Staff notes about this customer"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "th",
        "en"
      ],
      "default": "th"
    },
    "total_visits": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "loyalty_points": {
      "type": "number",
      "default": 0
    },
    "membership_tier": {
      "type": "string",
      "enum": [
        "none",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "none"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_visit_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "line_user_id",
    "display_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "nobody"
      }
    }
  }
}