{
  "name": "LoyaltyTier",
  "type": "object",
  "properties": {
    "name_th": {
      "type": "string",
      "description": "Tier name in Thai"
    },
    "name_en": {
      "type": "string",
      "description": "Tier name in English"
    },
    "tier_key": {
      "type": "string",
      "enum": [
        "none",
        "silver",
        "gold",
        "platinum"
      ],
      "description": "Unique tier identifier"
    },
    "min_points": {
      "type": "number",
      "description": "Minimum points required to reach this tier"
    },
    "benefits_th": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of benefits in Thai"
    },
    "benefits_en": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of benefits in English"
    },
    "discount_percentage": {
      "type": "number",
      "default": 0,
      "description": "Discount percentage for this tier"
    },
    "points_multiplier": {
      "type": "number",
      "default": 1,
      "description": "Multiplier for earning points (e.g., 1.5x)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name_th",
    "name_en",
    "tier_key",
    "min_points"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}